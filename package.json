{
  "name": "operators-booth",
  "version": "1.0.0",
  "description": "Meera's Railway Delay API - an x402 seller that turns messy railway delay notices into clean JSON, paid per call on Base Sepolia testnet.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "buyer": "tsx buyer/buyer.ts",
    "buyer:malformed": "tsx buyer/buyer.ts --malformed",
    "buyer:bulk": "tsx buyer/buyer.ts --bulk"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "viem": "^2.21.0",
    "x402": "^1.2.0",
    "x402-express": "^1.2.0",
    "x402-fetch": "^1.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.0",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
